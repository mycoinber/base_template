# ============================================================
# Theme Selection
# ACTIVE_THEME выбирает одну тему на весь текущий dev/build/deploy.
# Чтобы добавить новую тему, создай ./themes/<name> и зарегистрируй ее в theme.config.ts
# ============================================================

# ============================================================
# Theme Color Overrides
# Необязательно. Если не задать, используются дефолтные токены активной темы.
# Меняй эти значения, чтобы быстро перекрасить сайт без правки theme tokens.
# ============================================================
# NUXT_PUBLIC_COLOR_PRIMARY=#F8FF13        # Основной цвет (жёлтый)
# NUXT_PUBLIC_COLOR_SECONDARY=#e00840      # Вторичный цвет (красный)
# NUXT_PUBLIC_COLOR_ACCENT=#6c00e7         # Акцентный цвет (синий)
# NUXT_PUBLIC_COLOR_BG_PRIMARY=#000000     # Фон страницы
# NUXT_PUBLIC_COLOR_BG_SECONDARY=#2d3345  # Фон карточек/секций
# NUXT_PUBLIC_COLOR_TEXT_PRIMARY=#C8C3C7  # Основной цвет текста
# NUXT_PUBLIC_COLOR_TEXT_SECONDARY=#9a9a9a # Вторичный/приглушённый текст
# NUXT_PUBLIC_COLOR_TEXT_HEADING=#F8FF13  # Цвет заголовков
# NUXT_PUBLIC_COLOR_TEXT_INVERSE=#000000  # Инвертированный текст (на жёлтом фоне)
# NUXT_PUBLIC_COLOR_TEXT_CONTRAST=#ffffff # Контрастный текст на accent/secondary/dark surfaces
# NUXT_PUBLIC_COLOR_BORDER=#545969        # Цвет границ
# NUXT_PUBLIC_COLOR_STATE_HOVER=#FFE500   # Hover-состояние для primary элементов
